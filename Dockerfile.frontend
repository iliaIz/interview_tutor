# Production Nginx Server for Frontend SPA (SOTA 2026)
FROM nginx:alpine

# Copy prebuilt frontend static assets from bare-metal runner build
COPY frontend/dist /usr/share/nginx/html

# Copy custom Nginx configuration with HTML5 history routing and proxying
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
