# Models Configuration
LITELLM_BASE_URL=http://host.docker.internal:4000/v1
LITELLM_API_KEY=your_litellm_api_key

GEMINI_TEXT_MODEL=gemini-smart
GEMINI_LIVE_MODEL=gemini-live
GEMINI_TTS_MODEL=gemini-tts-v3
GEMINI_EMBEDDING_MODEL=gemini-embedding

# Custom Ports Configuration (Avoids collisions)
FRONTEND_PORT=8090
BACKEND_PORT=8091

# Deepgram nova-3
DEEPGRAM_API_KEY=your_deepgram_key
