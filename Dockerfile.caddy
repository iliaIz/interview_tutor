# Multi-stage Caddy Image with Embedded Frontend SPA (SOTA 2026)
# Stage 1: Build Frontend SPA
FROM node:22-bookworm-slim AS frontend-builder

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# Stage 2: Production Caddy 2.8 with embedded assets
FROM caddy:2.8-alpine AS runner

# Copy configuration
COPY Caddyfile /etc/caddy/Caddyfile

# Copy compiled frontend assets directly into web root
COPY --from=frontend-builder /app/dist /srv/frontend

EXPOSE 80 443

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
