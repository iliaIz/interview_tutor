# Production Caddy 2.8 with Embedded Prebuilt Frontend SPA (SOTA 2026)
FROM caddy:2.8-alpine AS runner

# Copy Caddy reverse proxy and static server configuration
COPY Caddyfile /etc/caddy/Caddyfile

# Copy prebuilt frontend assets directly into web root
COPY frontend/dist /srv/frontend

EXPOSE 80 443

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
