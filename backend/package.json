{
  "name": "interview-prep-backend",
  "version": "1.0.0",
  "description": "Backend API and Gemini Live WebSocket Proxy for Interview Prep Platform",
  "main": "dist/server.js",
  "scripts": {
    "prebuild": "npm --prefix ../shared run build",
    "build": "tsc && node -e \"const fs=require('fs'); fs.mkdirSync('dist/data/hr/fixtures', {recursive:true}); fs.cpSync('src/data/hr/fixtures', 'dist/data/hr/fixtures', {recursive:true});\"",
    "build:sandbox": "node src/scripts/buildSandbox.js",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test:prompts": "ts-node src/scripts/verifyPrompts.ts",
    "test:vad": "npm run test:vad:fault-injection && npm run test:vad:fixtures",
    "test:vad:unit": "ts-node src/scripts/testAcousticFixtures.ts && ts-node src/scripts/testGeminiConfigBuilder.ts",
    "test:vad:pacer": "ts-node src/scripts/testRealtimePacer.ts",
    "test:vad:fault-injection": "ts-node src/testing/testVadFaultInjection.ts",
    "test:vad:loopback": "ts-node src/scripts/testAcousticLoopback.ts",
    "test:vad:fixtures": "ts-node src/scripts/runAcousticVadMatrix.ts --fixtures",
    "test:vad:quick": "ts-node src/scripts/runAcousticVadMatrix.ts --engine=gemini-live-v3 --scenario=standard",
    "test:vad:multiturn": "ts-node src/scripts/runAcousticVadMatrix.ts --engine=gemini-live-v3 --scenario=multiturn",
    "test:vad:stress": "ts-node src/scripts/runAcousticVadMatrix.ts --engine=gemini-live-v3 --scenario=stress",
    "test:vad:thinking": "ts-node src/scripts/runAcousticVadMatrix.ts --engine=gemini-live-thinking-v3 --scenario=thinking",
    "test:vad:canary": "ts-node src/scripts/runAcousticVadMatrix.ts --suite=canary --mock",
    "test:vad:matrix": "ts-node src/scripts/runAcousticVadMatrix.ts --engine=all --scenario=all",
    "test:telemetry:engine": "ts-node src/scripts/testTelemetryEngine.ts",
    "test:telemetry:playout": "ts-node src/scripts/testPlayoutAndSkew.ts",
    "test:telemetry:db": "ts-node src/scripts/testTelemetryDb.ts",
    "test:telemetry:router": "ts-node src/scripts/testStreamRouterMock.ts",
    "test:telemetry:diagnostics": "ts-node src/scripts/testDiagnosticSkill.ts",
    "test:telemetry:matrix": "ts-node src/scripts/runAcousticVadMatrix.ts --engine=mock --scenario=all",
    "test:telemetry:all": "npm run test:telemetry:engine && npm run test:telemetry:playout && npm run test:telemetry:db && npm run test:telemetry:router && npm run test:telemetry:diagnostics && npm run test:telemetry:matrix",
    "pretest:practice:resilience": "npm run build",
    "test:practice:resilience": "node tests/test_practice_fault_injection.js",
    "test:practice:task-codes": "node tests/test_practice_task_codes.js && node tests/test_catalog_path_resolver.js",
    "test:catalog-paths": "node tests/test_catalog_path_resolver.js",
    "test:practice:mutation-challenges": "node tests/verify_all_mutation_challenges.js",
    "test:practice:scanner": "ts-node src/scripts/testTestQualityScanner.ts",
    "test:practice:ast-verifier": "ts-node src/scripts/testRefactoringAstVerifier.ts",
    "pretest:live:tool-isolation": "npm run build",
    "test:live:tool-isolation": "node tests/test_live_tool_silence_isolation.js",
    "verify-hygiene": "ts-node ../scripts/verify_file_hygiene.ts",
    "test:hr": "node tests/test_hr_routes.js && node tests/test_hr_simulator_engine.js && node tests/test_hr_acoustic_canary.js"
  },
  "dependencies": {
    "@google/genai": "*",
    "@interview-prep/shared": "file:../shared",
    "@sinclair/typebox": "^0.34.52",
    "better-sqlite3": "^12.11.1",
    "cel-js": "^0.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "livekit-server-sdk": "^2.18.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "@types/ws": "^8.5.13",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
