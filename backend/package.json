{
  "name": "interview-prep-backend",
  "version": "1.0.0",
  "description": "Backend API and Gemini Live WebSocket Proxy for Interview Prep Platform",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && javac -d bin src/services/sandbox/runner/*.java src/services/sandbox/runner/stubs/org/junit/jupiter/api/*.java src/services/sandbox/runner/stubs/org/junit/jupiter/api/function/*.java src/services/sandbox/runner/stubs/org/junit/jupiter/params/*.java src/services/sandbox/runner/stubs/org/junit/jupiter/params/provider/*.java src/services/sandbox/runner/stubs/org/assertj/core/api/*.java",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts"
  },
  "dependencies": {
    "@google/genai": "*",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "@types/ws": "^8.5.13",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
