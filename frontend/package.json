{
  "name": "interview-prep-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm --prefix ../shared run build && node scripts/copy_vad_assets.js",
    "build": "tsc && vite build",
    "test:audio-contracts": "npx tsx tests/audioPlayoutContracts.test.ts && npx tsx tests/liveAudioSessionContracts.test.ts && npx tsx tests/liveVoiceEngine.test.ts && npx tsx tests/liveVoiceStateMachine.test.ts && npx tsx tests/liveVoiceFrameParser.test.ts && npx tsx tests/workspaceAutosave.test.ts && npx tsx tests/ideBridgeContracts.test.ts && npx tsx tests/whiteboardRevisionStore.test.ts",
    "test:e2e:voice": "playwright test e2e/voiceSession.spec.ts",
    "verify-hygiene": "tsx ../scripts/verify_file_hygiene.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@electric-sql/pglite": "^0.5.15",
    "@interview-prep/shared": "file:../shared",
    "@lezer/highlight": "^1.2.3",
    "@ricky0123/vad-web": "^0.0.31",
    "@uiw/codemirror-themes": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "@xyflow/react": "^12.11.6",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "livekit-client": "^2.22.2",
    "lucide-react": "^0.469.0",
    "mermaid": "^11.17.2",
    "onnxruntime-web": "^1.30.0",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
