# Caddyfile for InterviewPrep AI (Production 2026)
# Supports djelu.site, www.djelu.site, 192-124-182-59.sslip.io, and port 80 fallback

{
    email admin@djelu.site
}

(common_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "microphone=(self), camera=(), geolocation=()"
    }
}

djelu.site, www.djelu.site, 192-124-182-59.sslip.io, :80 {
    import common_headers
    encode zstd gzip

    # 1. Real-Time Gemini Live Audio WebSocket Proxy (Zero Buffering)
    handle /ws/* {
        reverse_proxy backend:5000 {
            flush_interval -1
        }
    }

    # 2. REST API endpoints
    handle /api/* {
        reverse_proxy backend:5000
    }

    # 3. Frontend Static SPA with HTML5 History Routing
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }
}

mail.djelu.site {
    reverse_proxy snappymail:8888
}

ai.djelu.site, ai.192-124-182-59.sslip.io {
    import common_headers
    encode zstd gzip

    @ui_auth {
        not path /proxy-api/*
        not path /control/*
        not path /api/*
        not header Authorization Bearer*
    }
    basic_auth @ui_auth {
        djelu $2a$14$oxkQ/tCtGKSoIb8sB3asWeGAeWLzj/E2XtVYzMVdyDosTUls0cjla
    }

    reverse_proxy litellm-dashboard-ui:80
}
